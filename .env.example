# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# AUTH & ENCRYPTION SECRETS (Server-side only)
JWT_SECRET="replace-with-strong-random-jwt-secret"
CREDENTIAL_ENCRYPTION_KEY="replace-with-32-byte-hex-encryption-key"

# OFFICIAL VIRTUAL NUMBER PROVIDERS (Optional - Demo Sandbox active if unset)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
VONAGE_API_KEY=""
VONAGE_API_SECRET=""
TELNYX_API_KEY=""
TELNYX_MESSAGING_PROFILE_ID=""

# PAYMENT GATEWAY CONFIGURATION (Optional - Sandbox mode active if unset)
PAYMENT_GATEWAY_PROVIDER="sandbox"
PAYMENT_GATEWAY_SERVER_KEY=""
PAYMENT_GATEWAY_WEBHOOK_SECRET=""
